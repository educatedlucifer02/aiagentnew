# NVIDIA API Configuration
# Get your API key from: https://build.nvidia.com/moonshotai/kimi-k2-5
NVIDIA_API_KEY=your-nvidia-api-key-here

# Model Configuration
MODEL_NAME=moonshotai/kimi-k2.5
MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Sandbox Configuration
SANDBOX_TIMEOUT=30000
SANDBOX_MAX_OUTPUT_SIZE=10000

# Application Configuration
NEXT_PUBLIC_APP_NAME=Kimi Agent
NODE_ENV=production

# Optional: File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.txt,.csv,.json,.py,.js,.md,.pdf
